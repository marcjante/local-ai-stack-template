# Local development defaults. Never commit real tokens or production URLs.
HCPALAU_DATABASE_URL=sqlite:///./hcpalau.db
HCPALAU_ADMIN_TOKEN=replace-with-a-long-local-token
HCPALAU_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HCPALAU_VIDEO_DIR=./uploads/exercises

# Managed deployments may use the provider-standard aliases instead:
# DATABASE_URL=postgresql://...
# ADMIN_TOKEN=replace-with-a-random-production-token
# CORS_ORIGINS=https://your-frontend.example
# VIDEO_DIR=/data/exercise-videos
