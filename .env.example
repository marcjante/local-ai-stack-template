# Copia este fichero a .env y ajusta los valores para tu proyecto.

# Puertos (deben coincidir con config/services.yaml)
LLM_PORT=11434
VECTOR_DB_PORT=8000
BACKEND_PORT=8080
AUTOMATION_PORT=5678
DASHBOARD_PORT=8090
QUEUE_PORT=6379
DATABASE_PORT=5432
AGENT_1_PORT=9101
AGENT_2_PORT=9102
AGENT_3_PORT=9103
PROXY_PORT=80

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stack_template

# Rutas de datos locales
DATA_DIR=./data

# Claves externas del proyecto (si aplica)
# OPENAI_API_KEY=
# OTHER_SERVICE_TOKEN=
