# Copia este fichero a .env y ajusta los valores para tu proyecto.

# --- Puertos (deben coincidir con config/services.yaml) ---
LLM_PORT=11434
LLM_GATEWAY_PORT=8091
VECTOR_DB_PORT=8000
BACKEND_PORT=8080
AUTOMATION_PORT=5678
DASHBOARD_PORT=8090
QUEUE_PORT=6379
DATABASE_PORT=5432
PROXY_PORT=80

# --- Redis / RQ ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stack_template
DATABASE_URL=dbname=stack_template user=postgres password=postgres host=127.0.0.1 port=5432

# --- LLM Gateway (proveedores) ---
OLLAMA_URL=http://127.0.0.1:11434
LLM_MAX_CONCURRENT=2
LLM_GATEWAY_URL=http://127.0.0.1:8091
LLM_MODEL_DEFAULT=llama3.1
LLM_MODEL_FAST=llama3.1:8b
LLM_MODEL_REASONING=llama3.1:70b
LLM_PROVIDER_REASONING=ollama
# Proveedor compatible con OpenAI (LM Studio, vLLM, OpenAI real...), opcional:
OPENAI_COMPAT_URL=
OPENAI_COMPAT_API_KEY=

# --- Seguridad ---
# API key que el backend exige en la cabecera X-API-Key. Genera una real
# con, por ejemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=changeme-in-.env

# --- n8n (circuito bidireccional) ---
N8N_BASE_URL=http://127.0.0.1:5678
# Token que el worker manda en el header Authorization al llamar a n8n (saliente).
N8N_OUTBOUND_TOKEN=
# Secreto que el backend exige en X-N8N-Secret cuando n8n llama hacia dentro
# (entrante, /webhooks/n8n/<queue>). Configúralo igual en el nodo HTTP de n8n.
N8N_INBOUND_SECRET=changeme-in-.env

# --- RAG ---
# postgres_json: backend por defecto, funciona sin nada más que instalar.
# pgvector: requiere `CREATE EXTENSION vector;` en la base (ver db/schema.sql),
#   más rápido y escala mejor a partir de decenas de miles de chunks.
RAG_BACKEND=postgres_json
